FROM eclipse-temurin:21-jdk
WORKDIR /app

# Copiar el Maven Wrapper (estos archivos SÍ existen en tu proyecto)
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

# Dar permisos de ejecución al wrapper
RUN chmod +x mvnw

# Descargar dependencias (esto cachea las librerías)
RUN ./mvnw dependency:go-offline -B

# Copiar el código fuente
COPY src ./src
EXPOSE 8083

# Comando para desarrollo con perfil docker
CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.profiles=docker"]